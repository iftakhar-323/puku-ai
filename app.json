{
  "expo": {
    "name": "Puku AI",
    "slug": "puku-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#100D1D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pukuai"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#100D1D"
      },
      "package": "com.pukuai",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": []
  },
  "name": "PukuAI",
  "displayName": "Puku AI"
}
