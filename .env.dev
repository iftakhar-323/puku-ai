# Dev environment — used by the `dev` Android flavor (com.pukuai.dev,
# installs alongside prod/qa). Defaults to the same backend as prod since
# no separate dev backend URLs are known yet — replace these once you have
# real dev endpoints (the Flutter app's Sentry config hints at a
# `*.dev.puku.sh` pattern, e.g. https://api.app.dev.puku.sh).
API_BASE_URL=https://chat.api.puku.sh
AUTH_BASE_URL=https://puku.sh
AUTH_CLIENT_ID=puku-app
AUTH_REDIRECT_URI=puku://callback/
REMOTE_SESSION_RELAY_HOST=https://puku-cli.relay.puku.sh
PUKU_BOT_API_BASE_URL=https://app.bot.puku.sh/api/v1
PUKU_BOT_REDIRECT_URI=pukubot://auth/callback
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
